package yaqmc:provider@0.1.0;

interface utilities {
  log: func(level: string, message: string);
  monotonic-millis: func() -> u64;
  random-bytes: func(length: u32) -> result<list<u8>, string>;
}

interface storage {
  kv-get: func(key: string) -> result<option<string>, string>;
  kv-set: func(key: string, value: string) -> result<bool, string>;
  kv-delete: func(key: string) -> result<bool, string>;
  cache-get: func(key: string) -> result<option<list<u8>>, string>;
  cache-put: func(key: string, value: list<u8>) -> result<bool, string>;
  cache-delete: func(key: string) -> result<bool, string>;
}

interface network {
  request: func(request-json: string) -> result<string, string>;
}

interface credentials {
  create: func(origin: string, secret: string) -> result<string, string>;
  delete: func(handle: string) -> result<bool, string>;
}

world provider {
  export invoke: func(
    capability: string,
    operation: string,
    payload-json: string,
  ) -> result<string, string>;
}

world provider-network {
  import utilities;
  import network;
  export invoke: func(
    capability: string,
    operation: string,
    payload-json: string,
  ) -> result<string, string>;
}

world provider-account {
  import utilities;
  import storage;
  import network;
  import credentials;
  export invoke: func(
    capability: string,
    operation: string,
    payload-json: string,
  ) -> result<string, string>;
}
